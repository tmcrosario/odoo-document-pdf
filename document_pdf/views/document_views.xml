<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- FORM VIEW -->
    <record id="document_view_form" model="ir.ui.view">
        <field name="name">tmc.document.view.form</field>
        <field name="model">tmc.document</field>
        <field name="inherit_id" ref="tmc.document_view_form" />
        <field name="arch" type="xml">
            <button name="highlights_count_button" position="before">
                <field name="pdf_url" invisible="True" />
            </button>
            <xpath expr="//sheet" position="after">
                <div class="o_tmc_pdf_side" invisible="not pdf_url">
                    <field name="pdf_url" widget="tmc_pdf_pane" nolabel="1" />
                </div>
            </xpath>
        </field>
    </record>

    <!-- TREE VIEW -->
    <record id="document_view_tree" model="ir.ui.view">
        <field name="name">tmc.document.view.tree</field>
        <field name="model">tmc.document</field>
        <field name="inherit_id" ref="tmc.document_view_list" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="has_pdf" column_invisible="True" />
                <button
                    type="object"
                    title="View PDF"
                    class="pdf_icon"
                    name="open_pdf"
                    invisible="not has_pdf"
                    icon="fa-file-pdf-o text-danger"
                    width="45px"
                />
            </field>
        </field>
    </record>

    <!-- TREE VIEW (SIMPLE) -->
    <record id="document_simple_view_tree" model="ir.ui.view">
        <field name="name">tmc.document.simple.view.tree</field>
        <field name="model">tmc.document</field>
        <field name="inherit_id" ref="tmc.document_simple_view_list" />
        <field name="arch" type="xml">
            <field name="name" position="before">
                <field name="has_pdf" column_invisible="True" />
                <button
                    type="object"
                    title="View PDF"
                    class="pdf_icon"
                    name="open_pdf"
                    invisible="not has_pdf"
                    icon="fa-file-pdf-o text-danger"
                    width="45px"
                />
            </field>
        </field>
    </record>
</odoo>
